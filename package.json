{
  "name": "devomegle",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-devomegle",
    "test:rules": "firebase emulators:exec --project demo-devomegle --only firestore \"vitest run tests/rules.test.ts\"",
    "test:e2e": "firebase emulators:exec --project demo-devomegle --only firestore,auth \"playwright test\"",
    "test": "bun run test:rules && bun run test:e2e"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.49.1",
    "firebase": "^11.2.0",
    "firebase-tools": "^13.29.1",
    "vitest": "^2.1.8"
  }
}
