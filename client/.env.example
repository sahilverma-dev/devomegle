# Firebase web app configuration.
# Copy this file to client/.env and fill in the values from the Firebase console.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=

# Set to true to run against the local Firebase emulator suite instead of a
# real project. The app also exposes an anonymous "guest" login in this mode.
VITE_USE_EMULATOR=false
