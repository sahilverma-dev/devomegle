# Firebase web app configuration.
# Copy this file to client/.env and fill in the values from the Firebase console.
# Every value is validated at startup (src/lib/env.ts), so a missing one fails
# loudly instead of booting a client that cannot reach Firestore.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=

# Firebase serves its OAuth helper from `<authDomain>/__/auth/*`.
#
# `signInWithPopup` (the default flow) works with this on the Firebase domain.
# `signInWithRedirect` only works when that helper is first-party, because
# browsers that block third-party storage drop the result otherwise. To use the
# redirect flow reliably, set this to the app's own host and let it proxy:
#
#   development: localhost:3000          (vite.config.ts proxies /__/auth)
#   production:  your-app.vercel.app     (vercel.json rewrites /__/auth)
#
# Both are in place; leave this as `<project>.firebaseapp.com` to keep the
# helper on the Firebase domain.

# Set to true to run against the local Firebase emulator suite instead of a
# real project. The app also exposes an anonymous "guest" login in this mode.
# In emulator mode the Firebase values above may stay empty: the demo project
# defaults are filled in automatically.
VITE_USE_EMULATOR=false

# --- Server-side only ---------------------------------------------------------
# TURN credentials are minted by client/api/turn.js, which reads these from the
# host environment (for example the Vercel project settings). Never prefix them
# with VITE_ and never put them in a file that ships to the browser: the key can
# mint unlimited TURN credentials.
#
#   CLOUDFLARE_TURN_KEY_ID=
#   CLOUDFLARE_TURN_API_TOKEN=
